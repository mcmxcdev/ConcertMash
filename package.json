{
  "name": "concertmash",
  "description": "Easily generate a playlist for your upcoming concerts based on selected artists!",
  "version": "1.0.0",
  "author": "MCMXC",
  "license": "MIT",
  "homepage": "https://github.com/mcmxcdev/ConcertMash",
  "scripts": {
    "clean": "rm -rf .svelte-kit && rm -rf build",
    "dev": "vite dev",
    "validate": "svelte-kit sync && svelte-check",
    "format": "prettier --write --cache src/**/*{.svelte,.ts}",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "cssnano": "^9.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "filepond": "^4.32.12",
    "filepond-plugin-file-encode": "^2.1.14",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-preview": "^4.6.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "p-limit": "^7.3.3",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "spotify-web-api-js": "^1.5.2",
    "svelte": "^5.57.1",
    "svelte-awesome": "^3.3.5",
    "svelte-check": "^4.7.6",
    "svelte-filepond": "^0.2.2",
    "svelte-forms-lib": "^2.0.1",
    "svelte-select": "^6.0.0",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "yup": "^1.7.1"
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
